{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj",
                "--launch-profile",
                "http"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".",
                        "file": 1,
                        "location": 2,
                        "message": 3
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*Now listening on.*$",
                    "endsPattern": "^.*Application started.*$"
                }
            }
        },
        // -n 50 caps the number of generated test cases per API operation.
        // This balances schema coverage against run time; remove or increase for exhaustive runs.
        {
            "label": "schemathesis",
            "type": "shell",
            "dependsOn": ["run"],
            "command": "rm -rf \"${workspaceFolder}/schemathesis-test-report\" \"${workspaceFolder}/schemathesis-coverage-report\" && mkdir -p \"${workspaceFolder}/schemathesis-test-report\" \"${workspaceFolder}/schemathesis-coverage-report\" && docker run --rm --network=host -v \"${workspaceFolder}/schemathesis-test-report:/schemathesis-test-report\" -v \"${workspaceFolder}/schemathesis-coverage-report:/schemathesis-coverage-report\" -w /schemathesis-coverage-report schemathesis/schemathesis:4.17.0 run http://localhost:5237/openapi/v1.json --checks all --wait-for-schema 60 -n 50 --report junit --report-dir /schemathesis-test-report; DOCKER_EXIT=$?; ls \"${workspaceFolder}/schemathesis-test-report/\"junit-*.xml > /dev/null 2>&1 && npx --yes xunit-viewer --results \"${workspaceFolder}/schemathesis-test-report\" --output \"${workspaceFolder}/schemathesis-test-report/report.html\"; exit $DOCKER_EXIT"
        }
    ]
}