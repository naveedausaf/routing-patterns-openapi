{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/RoutingPatternsDemo/RoutingPatternsDemo.csproj"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": "$msCompile",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Build started",
                    "endsPattern": "Now listening on"
                }
            },
            "presentation": {
                "reveal": "always"
            }
        },
        {
            "label": "schemathesis",
            "type": "shell",
            "command": "docker run -t --rm --network container:$(cat /etc/hostname) schemathesis/schemathesis:4.17.0 run http://localhost:5237/openapi/v1.json",
            "dependsOn": "run",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always"
            }
        }
    ]
}